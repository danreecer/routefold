# ─────────────────────────────────────────────────────────────────────────────
# ROUTEFOLD — environment configuration
#
# Copy to `.env` and fill in. NEVER commit a populated .env file.
#   cp .env.example .env
#
# Values marked REQUIRED must be present for production mode.
# Values marked OPTIONAL have safe defaults.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# REQUIRED. PostgreSQL connection string.
# Local embedded dev server (see `pnpm dev:db`). The `pgbouncer=true` flag is
# required there: the embedded engine keeps one backend, so Prisma's named
# prepared statements would collide across connections without it.
#   postgresql://postgres:postgres@127.0.0.1:5433/routefold?pgbouncer=true&connection_limit=1
# Vercel Postgres / Neon / Supabase: use the pooled connection string and append
#   ?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/routefold?pgbouncer=true&connection_limit=1"

# REQUIRED. Direct (non-pooled) URL used only by `prisma migrate`.
# On a single-instance database set it to the same value as DATABASE_URL.
# On Neon/Supabase/Vercel Postgres use the *direct* (non-pooled) connection
# string here, because DDL cannot run through the transaction pooler.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/routefold?pgbouncer=true&connection_limit=1"

# ── Authentication (Clerk) ───────────────────────────────────────────────────
# REQUIRED for the authenticated application. Get these from
# https://dashboard.clerk.com → your app → API Keys.
# Without them the public site still works and every /app route explains the
# missing configuration instead of crashing.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# OPTIONAL. Routefold ships custom-styled auth screens at these paths.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# ── AI (Anthropic) ───────────────────────────────────────────────────────────
# REQUIRED for live analysis. https://console.anthropic.com
ANTHROPIC_API_KEY=""

# REQUIRED. Model identifier is configuration, never hardcoded in source.
# Use whichever current model your account has access to.
ANTHROPIC_MODEL="claude-sonnet-4-5"

# OPTIONAL. Per-stage generation ceiling.
ANTHROPIC_MAX_TOKENS=8000

# OPTIONAL. Per-stage wall-clock timeout in milliseconds.
AI_STAGE_TIMEOUT_MS=120000

# ── Usage limits ─────────────────────────────────────────────────────────────
# OPTIONAL. Complete report generations allowed per user during private beta.
REPORT_GENERATION_LIMIT=5

# OPTIONAL. Section regenerations allowed per user (each costs one unit).
SECTION_REGENERATION_LIMIT=25

# ── Application ──────────────────────────────────────────────────────────────
# REQUIRED in production. Canonical absolute origin, no trailing slash.
# Used for share links, sitemap, canonical tags and Open Graph metadata.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── External data enrichment ─────────────────────────────────────────────────
# OPTIONAL. When true, the chain knowledge base is enriched with public
# DeFiLlama TVL data. Falls back to the seeded snapshot when unavailable.
DEFILLAMA_ENABLED=true

# OPTIONAL. Cache lifetime for external chain data, in seconds.
CHAIN_DATA_CACHE_TTL_SECONDS=21600

# ── Source retrieval ─────────────────────────────────────────────────────────
# OPTIONAL. Hard limits for the server-side URL fetcher (SSRF-hardened).
FETCH_TIMEOUT_MS=12000
FETCH_MAX_BYTES=2000000
FETCH_MAX_REDIRECTS=3

# OPTIONAL. Set to "true" ONLY for local testing against a localhost fixture
# server. Disables private-network blocking. Never enable in production.
ALLOW_PRIVATE_NETWORK_FETCH=false

# ── Operating mode ───────────────────────────────────────────────────────────
# OPTIONAL. "true" enables the deterministic fixture pipeline for local
# development so the wizard is testable without an Anthropic key.
# Fixture output is ALWAYS labelled as such in the UI and stored with
# modelName="fixture". It is never used as a silent fallback for a failed
# live API call.
ROUTEFOLD_FIXTURE_MODE=false

# ── Rate limiting ────────────────────────────────────────────────────────────
# OPTIONAL. In-memory token bucket defaults (per user, per window).
RATE_LIMIT_ANALYSIS_PER_HOUR=10
RATE_LIMIT_FETCH_PER_HOUR=40
